{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "baseUrl": ".",
    "outDir": "dist",
    "declaration": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@engine": ["./calculation-engine/index.ts"],
      "@engine/*": ["./calculation-engine/*"],
      "@domain": ["./domain/index.ts"],
      "@domain/*": ["./domain/*"],
      "@structural": ["./structural-engine/index.ts"],
      "@structural/*": ["./structural-engine/*"],
      "@memorial/*": ["./memorial-engine/*"],
      "@block/*": ["./block-engine/*"],
      "@footing/*": ["./footing-engine/*"],
      "@caisson/*": ["./caisson-engine/*"],
      "@raft/*": ["./raft-engine/*"],
      "@assist": ["./assist-engine/index.ts"],
      "@assist/*": ["./assist-engine/*"],
      "@group": ["./pile-group-engine/index.ts"],
      "@group/*": ["./pile-group-engine/*"],
      "@drawing": ["./drawing-engine/index.ts"],
      "@drawing/*": ["./drawing-engine/*"],
      "@conception": ["./conception-engine/index.ts"],
      "@conception/*": ["./conception-engine/*"]
    }
  },
  "include": [
    "calculation-engine/**/*",
    "domain/**/*",
    "structural-engine/**/*",
    "memorial-engine/**/*",
    "block-engine/**/*",
    "footing-engine/**/*",
    "caisson-engine/**/*",
    "raft-engine/**/*",
    "assist-engine/**/*",
    "pile-group-engine/**/*",
    "drawing-engine/**/*",
    "conception-engine/**/*",
    "apps/web/src/store/wizardFlow.ts",
    "apps/web/src/store/wizardTypes.ts",
    "apps/web/src/store/patchPolicy.ts",
    "apps/web/src/store/columns.ts",
    "apps/web/src/store/columnCaps.ts",
    "apps/web/src/viz3d/rebarGeometry.ts",
    "tests/**/*"
  ],
  "exclude": ["apps/**", "node_modules", "dist"]
}
