{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["../../calculation-engine/*"],
      "@engine": ["../../calculation-engine/index.ts"],
      "@domain/*": ["../../domain/*"],
      "@domain": ["../../domain/index.ts"],
      "@structural/*": ["../../structural-engine/*"],
      "@structural": ["../../structural-engine/index.ts"],
      "@memorial/*": ["../../memorial-engine/*"],
      "@memorial": ["../../memorial-engine/index.ts"],
      "@block/*": ["../../block-engine/*"],
      "@block": ["../../block-engine/index.ts"],
      "@footing/*": ["../../footing-engine/*"],
      "@footing": ["../../footing-engine/index.ts"],
      "@caisson/*": ["../../caisson-engine/*"],
      "@caisson": ["../../caisson-engine/index.ts"],
      "@raft/*": ["../../raft-engine/*"],
      "@raft": ["../../raft-engine/index.ts"],
      "@assist/*": ["../../assist-engine/*"],
      "@assist": ["../../assist-engine/index.ts"],
      "@group/*": ["../../pile-group-engine/*"],
      "@group": ["../../pile-group-engine/index.ts"],
      "@drawing/*": ["../../drawing-engine/*"],
      "@drawing": ["../../drawing-engine/index.ts"],
      "@conception/*": ["../../conception-engine/*"],
      "@conception": ["../../conception-engine/index.ts"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "../../calculation-engine/**/*.ts",
    "../../domain/**/*.ts",
    "../../structural-engine/**/*.ts",
    "../../memorial-engine/**/*.ts",
    "../../block-engine/**/*.ts",
    "../../footing-engine/**/*.ts",
    "../../caisson-engine/**/*.ts",
    "../../raft-engine/**/*.ts",
    "../../assist-engine/**/*.ts",
    "../../pile-group-engine/**/*.ts",
    "../../drawing-engine/**/*.ts",
    "../../conception-engine/**/*.ts"
  ]
}
